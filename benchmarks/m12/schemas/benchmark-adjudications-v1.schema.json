{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnhunt.local/schemas/benchmark-adjudications-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "run_id", "admission", "adjudication"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_version": {"const": "benchmark-adjudications-v1"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{16}$"},
    "admission": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "target_match", "evidence_sha256"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "target_match": {"type": "boolean"},
          "evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "adjudication": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_candidate_id",
          "target_match",
          "validity",
          "adjudicator",
          "evidence_sha256"
        ],
        "properties": {
          "canonical_candidate_id": {"type": "string", "minLength": 1},
          "target_match": {"type": "boolean"},
          "validity": {"enum": ["real", "false", "unknown"]},
          "adjudicator": {"type": "string", "minLength": 1},
          "evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
