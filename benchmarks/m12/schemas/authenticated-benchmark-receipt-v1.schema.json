{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnhunt.local/schemas/authenticated-benchmark-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "run_id",
    "case_id",
    "repetition_index",
    "case_discovery_sha256",
    "freeze_root_sha256",
    "source",
    "model",
    "policies",
    "outcome",
    "authenticated",
    "oracle_isolated",
    "usage",
    "admission",
    "hunter_findings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_version": {"const": "authenticated-benchmark-receipt-v1"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{16}$"},
    "case_id": {"type": "string", "pattern": "^case_[0-9a-f]{16}$"},
    "repetition_index": {"type": "integer", "minimum": 1},
    "case_discovery_sha256": {"$ref": "#/$defs/sha256"},
    "freeze_root_sha256": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model_id"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1}
      }
    },
    "policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "outcome": {"enum": ["completed", "budget_limited", "invalid", "interrupted"]},
    "authenticated": {"const": true},
    "oracle_isolated": {"const": true},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "wall_time_ms"
      ],
      "properties": {
        "sessions": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cache_read_tokens": {"type": "integer", "minimum": 0},
        "cache_write_tokens": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0}
      }
    },
    "admission": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "hunter", "session_index"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "hunter": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "session_index": {"type": "integer", "minimum": 1}
        }
      }
    },
    "hunter_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "hunter", "session_index", "canonical_candidate_id"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "hunter": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "session_index": {"type": "integer", "minimum": 1},
          "canonical_candidate_id": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
