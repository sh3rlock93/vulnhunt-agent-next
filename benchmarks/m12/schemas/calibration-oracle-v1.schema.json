{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulnhunt.local/schemas/calibration-oracle-v1.schema.json",
  "title": "VulnHunt M12 calibration oracle",
  "type": "object",
  "additionalProperties": false,
  "required": ["oracle", "fixed_source", "location", "reproduction"],
  "properties": {
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_version",
        "case_id",
        "upstream_reference",
        "weakness",
        "supported_family",
        "required_hunter"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "policy_version": {"const": "calibration-oracle-v1"},
        "case_id": {"type": "string", "pattern": "^case_[0-9a-f]{16}$"},
        "upstream_reference": {"type": "string", "pattern": "^https://github\\.com/"},
        "weakness": {"type": "string", "minLength": 12},
        "supported_family": {
          "enum": [
            "bounded-write-capacity",
            "parser-cursor-oob-read",
            "integer-signedness-memory"
          ]
        },
        "required_hunter": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        }
      }
    },
    "fixed_source": {"$ref": "#/$defs/source"},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_paths", "sink_file", "sink_line_min", "sink_line_max"],
      "properties": {
        "required_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "entry_file": {"$ref": "#/$defs/path"},
        "entry_line_min": {"type": "integer", "minimum": 1},
        "entry_line_max": {"type": "integer", "minimum": 1},
        "sink_file": {"$ref": "#/$defs/path"},
        "sink_line_min": {"type": "integer", "minimum": 1},
        "sink_line_max": {"type": "integer", "minimum": 1}
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact_glob",
        "run_argv",
        "attempts",
        "timeout_seconds",
        "expected_vulnerable_sanitizer",
        "expected_vulnerable_frame",
        "expected_fixed_stdout"
      ],
      "properties": {
        "kind": {"enum": ["compiled-driver", "upstream-input"]},
        "artifact_glob": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "compile_argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "run_argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "attempts": {"type": "integer", "minimum": 2, "maximum": 3},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "expected_vulnerable_sanitizer": {
          "enum": ["heap-buffer-overflow", "stack-buffer-overflow"]
        },
        "expected_vulnerable_frame": {"type": "string", "minLength": 1},
        "expected_fixed_stdout": {"type": "string", "minLength": 1},
        "input_url": {"type": "string", "pattern": "^https://github\\.com/"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "input_size": {"type": "integer", "minimum": 1},
        "archive_member": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "compiled-driver"}}},
          "then": {"required": ["source", "compile_argv"]}
        },
        {
          "if": {"properties": {"kind": {"const": "upstream-input"}}},
          "then": {"required": ["input_url", "input_sha256", "input_size", "archive_member"]}
        }
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
